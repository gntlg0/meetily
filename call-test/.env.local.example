# Copy to .env.local and fill in. Never prefixed with NEXT_PUBLIC_ — these are
# read only in server-side code and must never reach the browser bundle.

# ElevenLabs Scribe (provider: "scribe")
ELEVENLABS_API_KEY=

# Anthropic (summaries)
ANTHROPIC_API_KEY=

# Optional: our future self-hosted model (provider: "custom").
# Any OpenAI-compatible POST {BASE_URL}/audio/transcriptions endpoint.
# For the bundled mock server (pnpm mock-asr), use http://127.0.0.1:3399/v1
CUSTOM_ASR_BASE_URL=
CUSTOM_ASR_API_KEY=
CUSTOM_ASR_MODEL=whisper-1

# Chimege (provider: "chimege") — not implemented yet, see src/lib/providers/chimege.ts
CHIMEGE_TOKEN=
